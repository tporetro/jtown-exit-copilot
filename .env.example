# Required: Claude API key (https://platform.claude.com) used by the coach and the document reader.
ANTHROPIC_API_KEY=""

# Optional: shared passcode. When set, the app asks for it once and every API call must include it.
# Strongly recommended for any copy that is reachable on the internet.
APP_PASSCODE=""

# Optional overrides
# PORT=3001
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=medium   # low = faster voice replies, high = deeper analysis
